# Copy to .env.local and fill in real values. NEVER commit .env.local

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_LOCALE=en
ENABLED_LOCALES=en,ar
APP_SECRET=change-me-to-64-char-random-string

MONGODB_URI=mongodb://127.0.0.1:27017/education_center

REDIS_URL=redis://127.0.0.1:6379
# Development defaults to in-memory cache. Set true only when Redis is running.
# REDIS_ENABLED=true

AUTH_SECRET=change-me-auth-secret-min-32-chars
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Optional: if unset or invalid, uploads go to public/upload on the server
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=education-media
R2_PUBLIC_DOMAIN=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRY_SECONDS=900

HLS_SEGMENT_DURATION=10
MAX_VIDEO_UPLOAD_BYTES=2147483648
MAX_AUDIO_UPLOAD_BYTES=524288000
MAX_PDF_UPLOAD_BYTES=52428800
# Optional: system ffmpeg on PATH. If unset or "ffmpeg", the app uses bundled ffmpeg-static.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

RATE_LIMIT_PUBLIC=10
RATE_LIMIT_AUTH=100
RATE_LIMIT_ADMIN=500
CSRF_SECRET=change-me-csrf-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_IP_WHITELIST=

LECTURE_CODE_LENGTH=12
LECTURE_CODE_MAX_ATTEMPTS_PER_MINUTE=5
# 1 = one student can redeem each generated code once
LECTURE_CODE_DEFAULT_MAX_USES=1

PROGRESS_HEARTBEAT_INTERVAL_MS=1000
PROGRESS_BATCH_SIZE=10

PROMOTION_MONTH=9
PROMOTION_DAY=1

SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-on-first-login
COLOR="#0fbaac"